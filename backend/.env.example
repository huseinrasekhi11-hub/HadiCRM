###############################################################
#
#                 HadiFlow Configuration
#
# این فایل نمونه تنظیمات پروژه است — کپی کنید به «.env» و مقادیر
# واقعی را جایگزین کنید. «.env» هرگز نباید commit شود (در
# .gitignore/.dockerignore قرار دارد).
#
# نکته: این فایل اکنون دقیقاً با app/config/settings.py هم‌خوانی
# دارد. پیش از این کلیدهایی مثل APP_NAME/REDIS_URL اینجا بودند که
# هیچ‌جای کد خوانده نمی‌شدند، و کلیدهای واقعاً لازم (ALGORITHM،
# ACCESS_TOKEN_EXPIRE_MINUTES) اصلاً نبودند — یعنی این فایل راهنمای
# غلطی برای راه‌اندازی محیط جدید بود.
#
###############################################################

###############################################################
# General
###############################################################

PROJECT_NAME=HadiFlow
DEBUG=true

###############################################################
# Database
###############################################################

# مثال: postgresql+psycopg2://hadiflow:CHANGE_ME@db:5432/hadiflow
DATABASE_URL=

# مقادیر زیر فقط توسط سرویس db در docker-compose.yml استفاده می‌شوند
# و باید با بخش اعتبارنامه‌ی DATABASE_URL بالا یکی باشند.
POSTGRES_USER=hadiflow
POSTGRES_PASSWORD=
POSTGRES_DB=hadiflow

###############################################################
# Security
###############################################################

# یک رشته‌ی تصادفی و طولانی؛ مثلاً: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

###############################################################
# CORS
###############################################################

# دامنه‌های مجاز، جدا شده با کاما — بدون فاصله‌ی اضافه
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

###############################################################
# Scheduler
###############################################################

# این استقرار فقط وب است؛ زمان‌بند باید در همین فرایند فعال باشد.
ENABLE_SCHEDULER=true
