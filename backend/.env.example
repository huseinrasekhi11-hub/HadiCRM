###############################################################
#
#                 HadiFlow Configuration
#
# این فایل نمونه تنظیمات پروژه است — کپی کنید به «.env» و مقادیر
# واقعی را جایگزین کنید. «.env» هرگز نباید commit شود (در
# .gitignore/.dockerignore قرار دارد).
#
# نکته: این فایل اکنون دقیقاً با app/config/settings.py هم‌خوانی
# دارد. پیش از این کلیدهایی مثل APP_NAME/REDIS_URL اینجا بودند که
# هیچ‌جای کد خوانده نمی‌شدند، و کلیدهای واقعاً لازم (ALGORITHM،
# ACCESS_TOKEN_EXPIRE_MINUTES) اصلاً نبودند — یعنی این فایل راهنمای
# غلطی برای راه‌اندازی محیط جدید بود.
#
###############################################################

###############################################################
# General
###############################################################

PROJECT_NAME=HadiFlow
# پیش‌فرض امن: false — فقط در محیط توسعه به‌صراحت true بگذارید
DEBUG=false

###############################################################
# Database
###############################################################

# مثال: postgresql+psycopg2://hadiflow:CHANGE_ME@db:5432/hadiflow
DATABASE_URL=

# مقادیر زیر فقط توسط سرویس db در docker-compose.yml استفاده می‌شوند
# و باید با بخش اعتبارنامه‌ی DATABASE_URL بالا یکی باشند.
POSTGRES_USER=hadiflow
POSTGRES_PASSWORD=
POSTGRES_DB=hadiflow

###############################################################
# Security
###############################################################

# اجباری؛ حداقل ۳۲ بایت. یک رشته‌ی تصادفی و طولانی بسازید:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_min_32_bytes_random_string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial admin bootstrap (required by render_start.sh / seed_admin).
# Set these only in the deployment environment; do not commit real credentials.
ADMIN_MOBILE=
ADMIN_PASSWORD=

#################################################################
# نشست / کوکیِ توکن تمدید
###############################################################

# توکن تمدید در کوکیِ HttpOnly است (نه localStorageِ فرانت‌اند)؛ این
# تنظیمات فقط در صورتی نیاز به تغییر دارند که API پشت یک پیشوند (مثل
# /api) سرو شود یا فرانت‌اند روی دامنه‌ی دیگری باشد.
#
#   * پیشوندِ متفاوت (مثلاً rewriteِ /api در Vercel):
#       REFRESH_COOKIE_PATH=/api/auth
#     در غیر این صورت مرورگر کوکی را برای /api/auth/refresh-token
#     نمی‌فرستد و نشست بعد از هر بارگذاریِ صفحه می‌پرد.
#   * فرانت‌اند و API روی یک دامنه (توصیه می‌شود): REFRESH_COOKIE_SAMESITE=lax
#   * فرانت‌اند و API روی دو دامنه:                REFRESH_COOKIE_SAMESITE=none
#     (در این حالت REFRESH_COOKIE_SECURE حتماً باید true بماند؛ برخی
#     مرورگرها — به‌ویژه Safari — کوکیِ بین‌دامنه‌ای را نمی‌پذیرند)
REFRESH_COOKIE_NAME=hadiflow_refresh
REFRESH_COOKIE_PATH=/auth
# Local HTTP development:
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# Production over HTTPS:
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=none  # only for a genuinely cross-site frontend/API
# معمولاً خالی؛ فقط وقتی لازم است کوکی برای زیر‌دامنه‌ها هم فرستاده شود
#REFRESH_COOKIE_DOMAIN=.example.com

###############################################################
# CORS
###############################################################

# دامنه‌های مجاز، جدا شده با کاما — بدون فاصله‌ی اضافه
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

###############################################################
# محدودسازی نرخ (brute-force)
#
# بودجه‌ی ورودِ ناموفق در دیتابیسِ مشترک نگه داشته می‌شود
# (جدول login_rate_events)، بنابراین بین همه‌ی workerها/replicaها
# یکی است. LOGIN_RATE_BACKEND=memory آن را به حافظه‌ی هر فرایند
# برمی‌گرداند (سقفِ مؤثر × تعداد نمونه‌ها) — فقط برای توسعه یا وقتی
# throttle در لبه/درگاه انجام می‌شود.
###############################################################

LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=30
PASSWORD_CHANGE_MAX_FAILURES=5
PASSWORD_CHANGE_WINDOW_SECONDS=900
LOGIN_RATE_BACKEND=auto

###############################################################
# Scheduler
###############################################################

# این استقرار فقط وب است؛ زمان‌بند باید در همین فرایند فعال باشد.
ENABLE_SCHEDULER=true