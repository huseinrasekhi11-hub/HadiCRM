+_JOB_LOCK_KEYS = {
+    "rule1_no_contact": 910001,
+    "rule2_morning_digest": 910002,
+    "rule3_escalation": 910003,
+    "rule4_followup_due": 910004,
+    "refresh_session_cleanup": 910005,
