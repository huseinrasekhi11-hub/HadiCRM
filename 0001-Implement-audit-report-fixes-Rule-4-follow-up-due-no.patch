+def single_instance(lock_name: str):
+    """دکوریتور: job فقط در یک فرایند/نسخه در هر لحظه اجرا می‌شود."""
+
+    def decorator(func):
+        @functools.wraps(func)
+        def wrapper(*args, **kwargs):
+            with _single_instance_lock(lock_name) as acquired:
